{
  "identifier": "postplanify",
  "name": "PostPlanify",
  "version": "1.0.0",
  "description": "Schedule social media posts to Instagram, TikTok, LinkedIn, X, Facebook, YouTube, Threads, Pinterest, Bluesky and Google Business Profile from your AI assistant. Plan your content calendar, track analytics and reply to comments.",
  "author": "PostPlanify",
  "authorUrl": "https://postplanify.com",
  "homepage": "https://postplanify.com",
  "cloudEndpoint": "https://api.postplanify.com/api/mcp",
  "icon": "https://raw.githubusercontent.com/postplanifyapp/postplanify-mcp/main/logo.png",
  "tags": [
    "social media",
    "social media scheduling",
    "content calendar",
    "instagram",
    "tiktok",
    "linkedin",
    "marketing",
    "analytics"
  ],
  "tools": [
    {
      "name": "get_current_user",
      "description": "Get the authenticated user's profile. Use this to verify the connection is working or to get user context.",
      "inputSchema": {
        "type": "object",
        "properties": {}
      }
    },
    {
      "name": "list_workspaces",
      "description": "List all workspaces (brands) the user has access to. Use this to find workspace IDs needed for other operations like listing posts or social accounts.",
      "inputSchema": {
        "type": "object",
        "properties": {}
      }
    },
    {
      "name": "get_workspace",
      "description": "Get detailed info about a specific workspace including its connected social accounts.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "workspaceId": {
            "type": "string",
            "description": "The workspace ID"
          }
        },
        "required": [
          "workspaceId"
        ],
        "additionalProperties": false,
        "$schema": "http://json-schema.org/draft-07/schema#"
      }
    },
    {
      "name": "list_social_accounts",
      "description": "List all connected social media accounts across all workspaces. Returns account IDs, platform types (INSTAGRAM, X, FACEBOOK, LINKEDIN, TIKTOK, YOUTUBE, THREADS, BLUESKY, PINTEREST), and account names. Use the returned account IDs when creating posts.",
      "inputSchema": {
        "type": "object",
        "properties": {}
      }
    },
    {
      "name": "get_social_account",
      "description": "Get details about a specific connected social account.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "accountId": {
            "type": "string",
            "description": "The social account ID"
          }
        },
        "required": [
          "accountId"
        ],
        "additionalProperties": false,
        "$schema": "http://json-schema.org/draft-07/schema#"
      }
    },
    {
      "name": "list_pinterest_boards",
      "description": "List Pinterest boards for a Pinterest account. Required when creating Pinterest posts; you must specify a boardId.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "accountId": {
            "type": "string",
            "description": "The Pinterest social account ID"
          }
        },
        "required": [
          "accountId"
        ],
        "additionalProperties": false,
        "$schema": "http://json-schema.org/draft-07/schema#"
      }
    },
    {
      "name": "upload_media_from_url",
      "description": "Download a file from a public URL and upload it to PostPlanify. This is the primary way to add images and videos for use in posts. Supports: JPEG, PNG, GIF, WebP, MP4, MOV, PDF. After uploading, use the returned media ID when creating posts. Workflow: 1) Upload media, 2) Note the returned media ID, 3) Create a post with the media IDs.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "url": {
            "type": "string",
            "description": "Public URL of the image or video to upload"
          },
          "filename": {
            "type": "string",
            "description": "Optional filename. If not provided, extracted from the URL."
          }
        },
        "required": [
          "url"
        ],
        "additionalProperties": false,
        "$schema": "http://json-schema.org/draft-07/schema#"
      }
    },
    {
      "name": "upload_media_from_base64",
      "description": "Upload a local file as base64. Use this when the user pastes an image or provides a local file path.\n\nSTEPS: Read the file with your file reading tool, then pass the raw base64 string directly to this tool. Do NOT compress, resize, or re-encode the file. Just read and pass it as-is.\n\nMax size: 20MB (covers virtually all images). Supports: JPEG, PNG, GIF, WebP, MP4, MOV, PDF. After uploading, use the returned media ID when creating posts.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "data": {
            "type": "string",
            "description": "Base64-encoded file content"
          },
          "filename": {
            "type": "string",
            "description": "Filename with extension (e.g. \"photo.jpg\")"
          },
          "mimeType": {
            "type": "string",
            "enum": [
              "image/jpeg",
              "image/png",
              "image/gif",
              "image/webp",
              "video/mp4",
              "video/quicktime",
              "application/pdf"
            ],
            "description": "MIME type of the file"
          }
        },
        "required": [
          "data",
          "filename",
          "mimeType"
        ],
        "additionalProperties": false,
        "$schema": "http://json-schema.org/draft-07/schema#"
      }
    },
    {
      "name": "list_media",
      "description": "List media you can attach to posts. IMPORTANT: to see a workspace's media library (the files the user uploaded in the PostPlanify dashboard), you MUST pass workspaceId; this is almost always what the user means by \"my media\" or \"my photos/videos\". Without workspaceId you only get files uploaded through the API/MCP, which is usually a small or empty subset. When the user refers to a workspace by name, call list_workspaces first to get its id, then pass it here. Use the returned ids with create_post; library and uploaded media both work. Each item has a \"source\" of \"library\" or \"upload\".",
      "inputSchema": {
        "type": "object",
        "properties": {
          "workspaceId": {
            "type": "string",
            "description": "REQUIRED to list a workspace's dashboard media library. Omit only when you specifically want just your API/MCP uploads (rare)."
          },
          "type": {
            "type": "string",
            "enum": [
              "image",
              "video"
            ],
            "description": "Filter library media by type."
          },
          "page": {
            "type": "integer",
            "exclusiveMinimum": 0,
            "description": "Library page number (default 1)."
          },
          "pageSize": {
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 100,
            "description": "Library items per page (default 50, max 100)."
          }
        },
        "additionalProperties": false,
        "$schema": "http://json-schema.org/draft-07/schema#"
      }
    },
    {
      "name": "delete_media",
      "description": "Permanently delete an uploaded media file by its ID.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "mediaId": {
            "type": "string",
            "description": "The media ID to delete"
          }
        },
        "required": [
          "mediaId"
        ],
        "additionalProperties": false,
        "$schema": "http://json-schema.org/draft-07/schema#"
      }
    },
    {
      "name": "list_posts",
      "description": "List posts with filters. Returns paginated results. workspaceId is required. Statuses: SCHEDULED, PUBLISHED, CANCELLED, RESCHEDULED.\n\nSet includeMetrics to true to attach each post's latest performance figures (views, likes, comments, shares, engagement rate). Use this to compare how posts performed instead of fetching them one at a time. A null metrics field means no analytics have been collected for that post, which is not the same as zero: never report it as zero.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "workspaceId": {
            "type": "string",
            "description": "The workspace ID (required)"
          },
          "status": {
            "type": "string",
            "enum": [
              "SCHEDULED",
              "PUBLISHED",
              "CANCELLED",
              "RESCHEDULED"
            ],
            "description": "Filter by post status"
          },
          "socialAccountId": {
            "type": "string",
            "description": "Filter by social account ID"
          },
          "platform": {
            "type": "string",
            "enum": [
              "FACEBOOK",
              "INSTAGRAM",
              "X",
              "LINKEDIN",
              "TIKTOK",
              "YOUTUBE",
              "THREADS",
              "BLUESKY",
              "PINTEREST",
              "GOOGLE_BUSINESS"
            ],
            "description": "Filter by platform"
          },
          "from": {
            "type": "string",
            "description": "Posts scheduled after this date (ISO 8601)"
          },
          "to": {
            "type": "string",
            "description": "Posts scheduled before this date (ISO 8601)"
          },
          "page": {
            "type": "integer",
            "exclusiveMinimum": 0,
            "description": "Page number (default: 1)"
          },
          "limit": {
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 100,
            "description": "Posts per page (default: 20, max: 100)"
          },
          "includeMetrics": {
            "type": "boolean",
            "description": "Attach latest performance metrics to each post (default: false)"
          }
        },
        "required": [
          "workspaceId"
        ],
        "additionalProperties": false,
        "$schema": "http://json-schema.org/draft-07/schema#"
      }
    },
    {
      "name": "create_post",
      "description": "Create and schedule a new social media post.\n\nWORKFLOW:\n1. Use list_social_accounts to get the target account ID\n2. If the post includes media, upload it first using upload_media_from_url\n3. Call this tool with the account ID and media IDs\n\nPLATFORM NOTES:\n- Instagram: Requires at least 1 image or video\n- YouTube: Requires 1 video + youtubeTitle\n- Pinterest: Requires pinterestBoardId (use list_pinterest_boards)\n- TikTok: Requires at least 1 image or video\n- X/Twitter: Max 280 chars, max 4 media\n- Google Business: topicType STANDARD (default), EVENT, or OFFER. EVENT/OFFER require eventTitle + startDate + endDate.\n\nscheduledAt must be a future ISO 8601 datetime.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "workspaceId": {
            "type": "string",
            "description": "The workspace ID"
          },
          "socialAccountId": {
            "type": "string",
            "description": "The social account ID to post to"
          },
          "scheduledAt": {
            "type": "string",
            "description": "Future ISO 8601 datetime (e.g. 2025-06-15T14:00:00Z)"
          },
          "caption": {
            "type": "string",
            "description": "The text content of the post"
          },
          "mediaIds": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Array of media IDs to attach (upload first)"
          },
          "isStory": {
            "type": "boolean",
            "description": "Post as a Story (Instagram/Facebook only)"
          },
          "youtubeParams": {
            "type": "object",
            "properties": {
              "title": {
                "type": "string",
                "description": "Video title (required)"
              }
            },
            "required": [
              "title"
            ],
            "additionalProperties": false,
            "description": "Required for YouTube posts"
          },
          "tiktokParams": {
            "type": "object",
            "properties": {
              "privacyLevel": {
                "type": "string",
                "enum": [
                  "PUBLIC_TO_EVERYONE",
                  "MUTUAL_FOLLOW_FRIENDS",
                  "FOLLOWER_OF_CREATOR",
                  "SELF_ONLY"
                ],
                "description": "Privacy level (required)"
              }
            },
            "required": [
              "privacyLevel"
            ],
            "additionalProperties": false,
            "description": "Required for TikTok posts"
          },
          "pinterestParams": {
            "type": "object",
            "properties": {
              "boardId": {
                "type": "string",
                "description": "Board ID (required); call list_pinterest_boards to get available boards"
              }
            },
            "required": [
              "boardId"
            ],
            "additionalProperties": false,
            "description": "Required for Pinterest posts"
          },
          "xCommunityId": {
            "type": "string",
            "description": "X Community ID to post in"
          },
          "xTaggedUsers": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "X usernames to tag"
          },
          "shortenLinks": {
            "type": "boolean",
            "description": "Shorten links in the caption with the workspace's connected Bitly account at publish time (ignored if Bitly is not connected)"
          },
          "utmCampaign": {
            "type": "string",
            "maxLength": 100,
            "description": "utm_campaign value added to links when shortenLinks is on"
          },
          "googleBusinessParams": {
            "type": "object",
            "properties": {
              "topicType": {
                "type": "string",
                "enum": [
                  "STANDARD",
                  "EVENT",
                  "OFFER"
                ],
                "description": "Post type (default: STANDARD)"
              },
              "actionType": {
                "type": "string",
                "enum": [
                  "BOOK",
                  "ORDER",
                  "SHOP",
                  "LEARN_MORE",
                  "SIGN_UP",
                  "CALL"
                ],
                "description": "CTA button type (not for OFFER posts)"
              },
              "actionUrl": {
                "type": "string",
                "description": "CTA button URL (required when actionType is set, except CALL)"
              },
              "eventTitle": {
                "type": "string",
                "description": "Event/Offer title (max 58 chars, required for EVENT/OFFER)"
              },
              "startDate": {
                "type": "string",
                "description": "Start date ISO 8601 (required for EVENT/OFFER)"
              },
              "endDate": {
                "type": "string",
                "description": "End date ISO 8601 (required for EVENT/OFFER)"
              },
              "couponCode": {
                "type": "string",
                "description": "Coupon code for OFFER posts (max 58 chars)"
              },
              "redeemOnlineUrl": {
                "type": "string",
                "description": "Redeem online URL for OFFER posts"
              },
              "termsConditions": {
                "type": "string",
                "description": "Terms & conditions for OFFER posts"
              }
            },
            "additionalProperties": false,
            "description": "Google Business post parameters"
          }
        },
        "required": [
          "workspaceId",
          "socialAccountId",
          "scheduledAt"
        ],
        "additionalProperties": false,
        "$schema": "http://json-schema.org/draft-07/schema#"
      }
    },
    {
      "name": "get_post",
      "description": "Get detailed info about a specific post including content, status, media, publishing logs, and its latest performance metrics (views, likes, comments, shares, engagement rate).\n\nThe `metrics` field is null when the post has not been published yet, or when no analytics have been collected for it. A null metric means no data, not a zero: never report it as zero.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "postId": {
            "type": "string",
            "description": "The post ID"
          }
        },
        "required": [
          "postId"
        ],
        "additionalProperties": false,
        "$schema": "http://json-schema.org/draft-07/schema#"
      }
    },
    {
      "name": "edit_post",
      "description": "Update a scheduled post. Only scheduled posts can be edited. Only include the fields you want to change.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "postId": {
            "type": "string",
            "description": "The post ID to edit"
          },
          "caption": {
            "type": "string",
            "description": "New caption text"
          },
          "scheduledAt": {
            "type": "string",
            "description": "New scheduled time (ISO 8601, must be in the future)"
          },
          "youtubeParams": {
            "type": "object",
            "properties": {
              "title": {
                "type": "string",
                "description": "Updated video title"
              }
            },
            "additionalProperties": false,
            "description": "Updated YouTube parameters"
          },
          "tiktokParams": {
            "type": "object",
            "properties": {
              "privacyLevel": {
                "type": "string",
                "enum": [
                  "PUBLIC_TO_EVERYONE",
                  "MUTUAL_FOLLOW_FRIENDS",
                  "FOLLOWER_OF_CREATOR",
                  "SELF_ONLY"
                ],
                "description": "Updated privacy level"
              }
            },
            "additionalProperties": false,
            "description": "Updated TikTok parameters"
          },
          "pinterestParams": {
            "type": "object",
            "properties": {
              "boardId": {
                "type": "string",
                "description": "Updated board ID"
              }
            },
            "additionalProperties": false,
            "description": "Updated Pinterest parameters"
          },
          "xCommunityId": {
            "type": "string",
            "description": "Updated X Community ID"
          },
          "xTaggedUsers": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Updated X tagged usernames"
          },
          "shortenLinks": {
            "type": "boolean",
            "description": "Turn Bitly link shortening on or off for this post"
          },
          "utmCampaign": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 100
              },
              {
                "type": "null"
              }
            ],
            "description": "Updated utm_campaign (null to remove)"
          },
          "googleBusinessParams": {
            "type": "object",
            "properties": {
              "topicType": {
                "type": "string",
                "enum": [
                  "STANDARD",
                  "EVENT",
                  "OFFER"
                ],
                "description": "Updated post type"
              },
              "actionType": {
                "anyOf": [
                  {
                    "anyOf": [
                      {
                        "not": {}
                      },
                      {
                        "type": "string",
                        "enum": [
                          "BOOK",
                          "ORDER",
                          "SHOP",
                          "LEARN_MORE",
                          "SIGN_UP",
                          "CALL"
                        ]
                      }
                    ]
                  },
                  {
                    "type": "null"
                  }
                ],
                "description": "Updated CTA type (null to remove)"
              },
              "actionUrl": {
                "anyOf": [
                  {
                    "anyOf": [
                      {
                        "not": {}
                      },
                      {
                        "type": "string"
                      }
                    ]
                  },
                  {
                    "type": "null"
                  }
                ],
                "description": "Updated CTA URL"
              },
              "eventTitle": {
                "type": "string",
                "description": "Updated event/offer title (max 58 chars)"
              },
              "startDate": {
                "type": "string",
                "description": "Updated start date (ISO 8601)"
              },
              "endDate": {
                "type": "string",
                "description": "Updated end date (ISO 8601)"
              },
              "couponCode": {
                "anyOf": [
                  {
                    "anyOf": [
                      {
                        "not": {}
                      },
                      {
                        "type": "string"
                      }
                    ]
                  },
                  {
                    "type": "null"
                  }
                ],
                "description": "Updated coupon code (max 58 chars)"
              },
              "redeemOnlineUrl": {
                "anyOf": [
                  {
                    "anyOf": [
                      {
                        "not": {}
                      },
                      {
                        "type": "string"
                      }
                    ]
                  },
                  {
                    "type": "null"
                  }
                ],
                "description": "Updated redeem URL"
              },
              "termsConditions": {
                "anyOf": [
                  {
                    "anyOf": [
                      {
                        "not": {}
                      },
                      {
                        "type": "string"
                      }
                    ]
                  },
                  {
                    "type": "null"
                  }
                ],
                "description": "Updated terms & conditions"
              }
            },
            "additionalProperties": false,
            "description": "Updated Google Business parameters"
          }
        },
        "required": [
          "postId"
        ],
        "additionalProperties": false,
        "$schema": "http://json-schema.org/draft-07/schema#"
      }
    },
    {
      "name": "cancel_post",
      "description": "Cancel a scheduled post. Only scheduled posts can be cancelled. Cancelled posts cannot be rescheduled; create a new post instead.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "postId": {
            "type": "string",
            "description": "The scheduled post ID to cancel"
          }
        },
        "required": [
          "postId"
        ],
        "additionalProperties": false,
        "$schema": "http://json-schema.org/draft-07/schema#"
      }
    },
    {
      "name": "delete_post",
      "description": "Permanently delete a post. This action cannot be undone.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "postId": {
            "type": "string",
            "description": "The post ID to delete"
          }
        },
        "required": [
          "postId"
        ],
        "additionalProperties": false,
        "$schema": "http://json-schema.org/draft-07/schema#"
      }
    },
    {
      "name": "get_account_analytics",
      "description": "Get analytics data for a specific social account; includes account-level metrics (followers, following) and post-level metrics (views, likes, comments, engagement rate). Returns platform-specific data format.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "workspaceId": {
            "type": "string",
            "description": "The workspace ID"
          },
          "socialAccountId": {
            "type": "string",
            "description": "The social account ID"
          }
        },
        "required": [
          "workspaceId",
          "socialAccountId"
        ],
        "additionalProperties": false,
        "$schema": "http://json-schema.org/draft-07/schema#"
      }
    },
    {
      "name": "get_analytics_trends",
      "description": "Get historical trend data for a social account; follower growth and engagement metrics over time. Returns daily snapshots for the specified number of days.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "workspaceId": {
            "type": "string",
            "description": "The workspace ID"
          },
          "socialAccountId": {
            "type": "string",
            "description": "The social account ID"
          },
          "days": {
            "type": "integer",
            "minimum": 1,
            "maximum": 365,
            "description": "Number of days to look back (default: 30, max: 365)"
          }
        },
        "required": [
          "workspaceId",
          "socialAccountId"
        ],
        "additionalProperties": false,
        "$schema": "http://json-schema.org/draft-07/schema#"
      }
    },
    {
      "name": "get_brand_overview",
      "description": "Get an aggregated analytics overview for a workspace; includes all connected social accounts with 7-day metrics (views, engagement, follower changes), top 10 posts, and daily view/engagement trends over the same window.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "workspaceId": {
            "type": "string",
            "description": "The workspace ID"
          }
        },
        "required": [
          "workspaceId"
        ],
        "additionalProperties": false,
        "$schema": "http://json-schema.org/draft-07/schema#"
      }
    },
    {
      "name": "list_comments",
      "description": "List comments and reviews synced from Instagram, Facebook, LinkedIn, and Google Business for a workspace. Returns top-level comments with author, text, platform, post context, and read/hidden state. Use this to triage an inbox or find a comment ID before replying.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "workspaceId": {
            "type": "string",
            "description": "The workspace ID"
          },
          "socialAccountId": {
            "type": "string",
            "description": "Filter by a specific connected account"
          },
          "platform": {
            "type": "string",
            "enum": [
              "INSTAGRAM",
              "FACEBOOK",
              "LINKEDIN",
              "GOOGLE_BUSINESS"
            ],
            "description": "Filter by platform (inbox-capable platforms only)"
          },
          "unreadOnly": {
            "type": "boolean",
            "description": "If true, only return comments not yet marked as read"
          },
          "page": {
            "type": "integer",
            "minimum": 1,
            "description": "Page number (default 1)"
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 50,
            "description": "Items per page (default 20, max 50)"
          }
        },
        "required": [
          "workspaceId"
        ],
        "additionalProperties": false,
        "$schema": "http://json-schema.org/draft-07/schema#"
      }
    },
    {
      "name": "list_comment_replies",
      "description": "Fetch the direct replies to a specific comment. Use the `id` returned from list_comments as the platformCommentId. For LinkedIn URNs, pass the raw value as-is (e.g. \"urn:li:comment:(activity:123,456)\"); no URL encoding.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "platformCommentId": {
            "type": "string",
            "description": "Platform-native comment ID returned by list_comments"
          }
        },
        "required": [
          "platformCommentId"
        ],
